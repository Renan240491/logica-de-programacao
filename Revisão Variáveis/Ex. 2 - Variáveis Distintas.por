programa {
  funcao inicio() 
  {
       // Declaração das variáveis
        inteiro numero1, numero6, soma, subtracao, multiplicacao, divisao  
  
        // Entrada de dados
        escreva("Digite o primeiro número:")
          leia(numero1)

        escreva ("Digite o segundo número:")
          leia(numero6)

        // Processamento (cálculo da soma)
          soma = numero1 + numero6 
          subtracao = numero1 - numero6
          multiplicacao = numero1 * numero6
          divisao = numero1 / numero6
        
        // Saída de dados (exibição do resultado)
        
        escreva("O resultado da soma é: ",soma, "\n")

        escreva("O resultado da subtracao é: ",subtracao, "\n")

        escreva("O resultado da multiplicação é: ",multiplicacao, "\n")

        escreva("O resultado da divisao  é: ",divisao, "\n")
  
      }  
    }
  }
}
